{
  "name": "english-vocabulary",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -p tsconfig.json --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview --port 5173",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply english-vocabulary --local",
    "db:migrate:remote": "wrangler d1 migrations apply english-vocabulary --remote",
    "seed:build": "node scripts/build-seed.mjs",
    "seed:local": "node scripts/build-seed.mjs && wrangler d1 execute english-vocabulary --local --file=.seed/seed.sql",
    "seed:remote": "node scripts/build-seed.mjs && wrangler d1 execute english-vocabulary --remote --file=.seed/seed.sql",
    "deploy:api": "wrangler deploy",
    "convert:4000": "node scripts/convert-4000.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "^7.9.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.86.0"
  }
}
